{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "defaultMode": "default",
        "allow": [
            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(git show:*)",
            "Bash(git branch:*)",
            "Bash(git ls-files:*)",
            "Bash(git blame:*)",
            "Read(Assets/**)",
            "Read(Packages/**)",
            "Read(ProjectSettings/**)",
            "Read(.claude/**)"
        ],
        "ask": [
            "Bash(git commit:*)",
            "Bash(git push:*)",
            "Bash(git reset:*)",
            "Bash(git checkout:*)"
        ],
        "deny": [
            "Read(Library/**)",
            "Read(Temp/**)",
            "Read(Logs/**)",
            "Read(obj/**)",
            "Read(Build/**)",
            "Read(Builds/**)",
            "Read(UserSettings/**)",
            "Edit(Library/**)",
            "Edit(Temp/**)",
            "Edit(obj/**)",
            "Edit(ProjectSettings/ProjectVersion.txt)"
        ]
    },
    "env": {},
    "hooks": {}
}
